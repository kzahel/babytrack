// The hosted Lantern web app: static assets only, no Worker code. The bundle
// is built by scripts/build_web_pages.sh, which also writes its _headers.
{
  "name": "lantern",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "lantern.kzahel.com", "custom_domain": true }],
  "workers_dev": true
}
